<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".MainActivity">

    <!-- 顶部安全状态指示器 -->
    <LinearLayout
        android:id="@+id/status_indicator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/status_indicator_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_16"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 网络连接状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/network_status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_network_wifi"
                app:tint="?attr/colorPrimary" />
            <TextView
                android:id="@+id/network_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_connected"
                android:layout_marginStart="@dimen/spacing_8"
                android:textAppearance="@style/TextAppearance.SafeWalk.BodySmall"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 定位服务状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/location_status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location_on"
                app:tint="?attr/colorPrimary" />
            <TextView
                android:id="@+id/location_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_location_on"
                android:layout_marginStart="@dimen/spacing_8"
                android:textAppearance="@style/TextAppearance.SafeWalk.BodySmall"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- 守护状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/guard_status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shield_check"
                app:tint="?attr/colorPrimary" />
            <TextView
                android:id="@+id/guard_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_not_guarding"
                android:layout_marginStart="@dimen/spacing_8"
                android:textAppearance="@style/TextAppearance.SafeWalk.BodySmall"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <!-- 主内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/status_indicator"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_16">

            <!-- 应用标题 -->
            <TextView
                android:id="@+id/app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.SafeWalk.HeadlineLarge"
                android:textColor="?attr/colorOnBackground"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 安全提示横幅 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/safety_tip_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="?attr/colorAmberAlertContainer"
                app:cardCornerRadius="@dimen/corner_radius_medium"
                app:cardElevation="@dimen/elevation_small"
                app:layout_constraintTop_toBottomOf="@id/app_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_16"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/color_amber_alert" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/safety_tip"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:textAppearance="@style/TextAppearance.SafeWalk.BodyMedium"
                        android:textColor="?attr/colorOnBackground" />

                    <Button
                        android:id="@+id/safety_tip_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/safety_tip_action"
                        android:textAppearance="@style/TextAppearance.SafeWalk.BodySmall"
                        android:textColor="?attr/colorPrimary"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 模式选择区 -->
            <LinearLayout
                android:id="@+id/mode_selection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_24"
                app:layout_constraintTop_toBottomOf="@id/safety_tip_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- 走夜路模式 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/walking_mode_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mode_card_height"
                    android:layout_marginBottom="@dimen/spacing_12"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/corner_radius_large"
                    app:cardElevation="@dimen/elevation_medium"
                    app:strokeWidth="2dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_16"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mode_walking"
                                android:textAppearance="@style/TextAppearance.SafeWalk.TitleLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mode_walking_desc"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:textAppearance="@style/TextAppearance.SafeWalk.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_directions_walk"
                            app:tint="?attr/colorPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 打车模式 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/taxi_mode_card"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/mode_card_height"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="@dimen/corner_radius_large"
                    app:cardElevation="@dimen/elevation_medium"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_16"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mode_taxi"
                                android:textAppearance="@style/TextAppearance.SafeWalk.TitleLarge"
                                android:textColor="?attr/colorOnSurface" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mode_taxi_desc"
                                android:layout_marginTop="@dimen/spacing_4"
                                android:textAppearance="@style/TextAppearance.SafeWalk.BodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_directions_car"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 最近联系人 -->
            <LinearLayout
                android:id="@+id/contacts_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_24"
                app:layout_constraintTop_toBottomOf="@id/mode_selection"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recent_contacts"
                    android:textAppearance="@style/TextAppearance.SafeWalk.TitleMedium"
                    android:textColor="?attr/colorOnBackground" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/spacing_12">

                    <!-- 联系人1 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/contact_item_height"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_8"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/corner_radius_medium"
                        app:cardElevation="@dimen/elevation_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_12"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/colorPrimary"
                                android:backgroundTint="?attr/colorPrimary"
                                android:shape="oval" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="妈妈"
                                android:layout_marginStart="@dimen/spacing_12"
                                android:textAppearance="@style/TextAppearance.SafeWalk.BodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 联系人2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="@dimen/contact_item_height"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_8"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="@dimen/corner_radius_medium"
                        app:cardElevation="@dimen/elevation_small">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_12"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/colorSecondary"
                                android:backgroundTint="?attr/colorSecondary"
                                android:shape="oval" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="爸爸"
                                android:layout_marginStart="@dimen/spacing_12"
                                android:textAppearance="@style/TextAppearance.SafeWalk.BodyMedium"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- 设置按钮 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_settings"
                android:tint="?attr/colorOnPrimary"
                app:backgroundTint="?attr/colorPrimary"
                app:fabSize="normal"
                app:layout_constraintTop_toBottomOf="@id/contacts_section"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/spacing_104" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- 底部悬浮SOS按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/sos_button"
        android:layout_width="@dimen/sos_button_diameter"
        android:layout_height="@dimen/sos_button_diameter"
        android:text="@string/sos_button_text"
        android:textAppearance="@style/TextAppearance.SafeWalk.TitleLarge"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/color_crimson_emergency"
        app:shapeAppearance="@style/ShapeAppearance.SafeWalk.LargeComponent"
        app:cornerRadius="@dimen/corner_radius_full"
        app:elevation="@dimen/elevation_xlarge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/spacing_16" />

</androidx.constraintlayout.widget.ConstraintLayout>
