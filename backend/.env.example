# 应用配置
APP_NAME=SafeWalk Backend
APP_VERSION=1.0.0
DEBUG=False

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres?ssl=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30

# Clerk认证配置
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=[]

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
BACKEND_CORS_ORIGINS=["*"]

# 日志配置
LOG_LEVEL=INFO
